  "properties": {
    "nameOverride": {
      "type": "string",
      "default": "",
      "description": "Overrides the name of the chart (without the release name). For example, setting `nameOverride` to \"hello\" would produce a workload named \"release-name-hello\". Containers within a pod derive their name from this setting.\n\nBy default, the name of the chart is used.\n"
    },
    "fullnameOverride": {
      "type": "string",
